{
  "name": "dsh-balance",
  "version": "0.1.0",
  "description": "DeepSeek account balance history and spend in the dsh shell: 1d/1w/1m cost measured from balance differences, with a per-day ledger and session cost estimate",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint:dead": "knip --no-config-hints",
    "lint:dup": "jscpd --min-tokens 60 --min-lines 10 --threshold 1 --reporters console --format javascript src client",
    "lint": "npm run lint:dead && npm run lint:dup",
    "ci": "npm ci --ignore-scripts && npm run lint && npm test",
    "release:notes": "node scripts/release-notes.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-chunked-list": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "jscpd": "4.3.0",
    "knip": "5.88.1",
    "zod": "4.4.3"
  }
}
